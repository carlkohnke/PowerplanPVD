# Copy this file to a .yaml file and place the legacy workbook beside it,
# or replace profile.path with the workbook's full path.
name: Legacy Ni-Ti-Nb distance-optimized profile

profile:
  path: ${SPUTTERPLAN_LEGACY_WORKBOOK}
  sheet: Distance Optimized
  header_row: 2
  data_start_row: 3
  data_end_row: 603
  distance_column: A
  composition_columns:
    Ni: B
    Ti: C
    Nb: D
  composition_basis: fraction
  composition_sum_tolerance: 0.000002

targets:
  - name: Ni
    rate_nm_per_min_per_watt: 0.1003
    off_below_power_w: 1.0
    min_stable_power_w: 2.0
  - name: Ti
    rate_nm_per_min_per_watt: 0.0533
    off_below_power_w: 1.0
    min_stable_power_w: 2.0
  - name: Nb
    rate_nm_per_min_per_watt: 0.0710
    off_below_power_w: 1.0
    min_stable_power_w: 2.0

operation:
  strategy: total_power
  total_power_w: 300.0
  calculation_mode: legacy_compatible
  hardware_limit_policy: clip
  # The MATLAB equations omit the composition equation for chamber 2 (Ti),
  # making it the balance/slack target when rounded rows do not sum exactly.
  legacy_slack_target: Ti

planner:
  power_tolerance_abs_w: 2.0
  power_tolerance_rel: 0.20
  composition_tolerance_abs: 0.03
  max_breakpoints: 100
  ramp_rate_resolution_w_per_s: 0.001
